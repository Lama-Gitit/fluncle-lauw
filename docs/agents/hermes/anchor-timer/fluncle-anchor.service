[Unit]
Description=fluncle-anchor — rave-02 host trigger for the catalogue Spotify-anchor sweep
Documentation=https://github.com/mauricekleine/fluncle/blob/main/docs/agents/hermes/anchor-timer/README.md
Wants=network-online.target docker.service
After=network-online.target docker.service
# If this unit dies before writing its own /status marker (OOM, missing binary, a crash
# before the sweep catch runs), the healthcheck prober never sees a failure. This catch-all
# posts a minimal Discord alert; %n is this unit's full name.
OnFailure=fluncle-sweep-failure@%n.service

[Service]
Type=oneshot
# Root drives the Docker daemon; `docker exec -u hermes` runs the WORK as the unprivileged
# hermes user. The .sh/.ts pair is BAKED at /opt/hermes-scripts/ (auto-updates from main via
# pin-watch); this host unit only TRIGGERS it, and the sweep self-writes its /status marker
# (cron-output.sh). Secrets (the agent token + APIFY_API_TOKEN) come from the shared op-injected
# ${HOME}/.fluncle-secrets.env the wrapper sources.
ExecStart=/usr/bin/docker exec -u hermes -e HOME=/opt/data/home -e FLUNCLE_ANCHOR_BATCH=100 hermes bash /opt/hermes-scripts/anchor-sweep.sh
# One tick drains 100 rows (`FLUNCLE_ANCHOR_BATCH`) — the sweep PAGES the worklist in ≤200-row reads
# (the server clamp), so the batch may exceed one read's cap (anchor-sweep.ts `runAnchorSweep`).
# The rungs themselves cost no Apify dollars; what bounds the batch is the SHARED Spotify app.
#
# THE BATCH IS A BURST, AND THE BURST IS WHAT THE BREAKER SEES. Every ListenBrainz candidate spends
# one Spotify by-id read on the shared official app, so a tick's row count IS its burst against that
# app's rate budget. Past roughly this size the burst trips the shared throttle breaker
# (lib/server/spotify-anchor-breaker.ts — 5 × 429 inside a 10-minute window), and that breaker's
# cooldown is ONE HOUR: exactly this timer's cadence, so a single trip costs the whole NEXT tick
# rather than the rest of this one. A tripped breaker also gates BOTH free rungs at once — the LB
# by-id read AND the exact-ISRC ask — so a tick under a tripped breaker anchors nothing at all.
# Fewer rows that resolve beat more rows that yield: raise this only against a ledger window showing
# `lbYieldedOnBreaker` at zero across a full day.
#
# Put the value HERE, never in a `fluncle-anchor.service.d/` drop-in: a drop-in wins silently, and
# then reading this unit tells you the wrong thing.
# The 50-min timeout leaves generous headroom and still sits under the 1h cadence, so an over-long
# tick just skips the next trigger and self-heals. Once the ready pool is dry the sweep no-ops on an
# empty queue, so the batch is a ceiling rather than a spend.
TimeoutStartSec=3000
# Modest hardening for a root docker-driving oneshot.
NoNewPrivileges=true
ProtectControlGroups=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
